   "vivecraft.options.VR_TOGGLE_BUTTON_VISIBLE.tooltip": "Ob der VR Aktivierungsknopf im Hauptmenü gezeigt werden soll.",
   "vivecraft.options.VR_SETTINGS_BUTTON_VISIBLE.tooltip": "Ob der 'VR Einstellungen' Knopf im Optionsmenü angezeigt werden soll.",
   "vivecraft.options.VR_SETTINGS_BUTTON_POSITION.tooltip": "Ob der 'VR Einstellungen' Knopf im Optionsmenü links oder rechts positioniert werden soll.",
diff --git a/common/src/main/resources/assets/vivecraft/lang/en_us.json b/common/src/main/resources/assets/vivecraft/lang/en_us.json
index 0f04417..efaf3ed 100644
--- a/common/src/main/resources/assets/vivecraft/lang/en_us.json
+++ b/common/src/main/resources/assets/vivecraft/lang/en_us.json
@@ -663,6 +663,7 @@
